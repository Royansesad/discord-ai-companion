{
  "name": "discord-ai-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord AI companion that joins voice channels, hears each speaker separately, and replies with ElevenLabs TTS.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/index.js",
    "dev": "node --env-file-if-exists=.env --watch dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "selftest": "npm run build && node --env-file-if-exists=.env dist/scripts/voice-selftest.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.16.3",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  }
}

# --- Discord ---------------------------------------------------------------
# Bot token dari https://discord.com/developers/applications (tab Bot -> Reset Token)
DISCORD_TOKEN=
# Opsional: isi ID server untuk registrasi slash command instan (kalau kosong: global, bisa telat ~1 jam)
DISCORD_GUILD_ID=

# --- STT: Groq (free tier, tanpa kartu) ------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Kode bahasa ISO-639-1; "id" untuk Indonesia. Kosongkan untuk auto-detect.
STT_LANGUAGE=id

# --- LLM: OpenRouter -------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Fallback dipisah koma. HANYA pakai model :free di sini supaya tidak pernah tertagih otomatis.
OPENROUTER_FALLBACK_MODELS=

# --- TTS utama: ElevenLabs -------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# WAJIB. Pilih voice berbahasa Indonesia di Voice Library, kalau tidak logatnya jadi bule:
# https://elevenlabs.io/app/voice-library (filter bahasa Indonesian) -> salin Voice ID
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (cepat & murah) | eleven_turbo_v2_5 | eleven_multilingual_v2 (paling natural)
ELEVENLABS_MODEL=eleven_flash_v2_5
# ISO-639-1; dipakai model flash/turbo supaya pelafalan & logatnya Indonesia
ELEVENLABS_LANGUAGE_CODE=id
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

# --- TTS cadangan: fish.audio ----------------------------------------------
# https://fish.audio (Get API key)
FISH_API_KEY=
# s2.1-pro-free gratis s/d 30 Nov 2026, setelah itu ganti ke s2.1-pro (berbayar)
FISH_MODEL=s2.1-pro-free
# Isi dengan voice Indonesia; voice default fish berlogat Inggris
FISH_VOICE_ID=
FISH_LATENCY=balanced

# --- Anggaran --------------------------------------------------------------
# Provider utama: elevenlabs | fish (yang lain otomatis dipakai sebagai cadangan)
TTS_PROVIDER=elevenlabs
# Batas karakter TTS per hari (0 = tanpa batas). 20000 ~ 25 menit bicara.
TTS_DAILY_CHAR_LIMIT=20000

# --- Perilaku voice (opsional, ada default) --------------------------------
VOICE_SILENCE_MS=700
VOICE_MIN_SPEECH_MS=600
VOICE_MAX_UTTERANCE_MS=15000
VOICE_MAX_QUEUE=3
VOICE_AUTO_LEAVE_MS=120000
VOICE_HISTORY_TURNS=20
# Berapa giliran lama dikumpulkan sebelum dirangkum jadi memori
VOICE_SUMMARY_EVERY=12
# Nama panggilan tambahan untuk mode "panggil" (pisah koma); nama bot Discord otomatis dipakai
VOICE_WAKE_WORD=

# --- State (persona, mode, memori, pemakaian TTS) ---------------------------
STATE_FILE=state.json

# Log detail (transkrip, request provider)
DEBUG=false
